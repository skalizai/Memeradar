{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["PROVIDER_MODE", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {},
    "lint": {}
  }
}
