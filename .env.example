# ─────────────────────────────────────────────────────────────────────────────
# MemeRadar environment variables
# Copy to `.env` (worker / docker-compose) and `apps/web/.env.local` (web app).
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared ───────────────────────────────────────────────────────────────────
# Supabase project URL and keys (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: worker only (bypasses RLS). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Default display timezone (IANA name). Data is always stored in UTC.
DEFAULT_TIMEZONE=Asia/Dubai

# Link pattern for opening a token on Axiom. `{mint}` is replaced with the mint address.
# MemeRadar only links to Axiom — it never calls any Axiom endpoint.
NEXT_PUBLIC_AXIOM_URL_PATTERN=https://axiom.trade/meme/{mint}

# ── Web app (apps/web) ───────────────────────────────────────────────────────
# Public base URL of the deployed dashboard (used in email links and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Self sign-up is disabled; the single user account is created once.
ALLOW_SIGNUP=false

# ── Worker (apps/worker) ─────────────────────────────────────────────────────
# free   = PumpPortal + Helius Free + Birdeye Standard (rate/credit-limited)
# live   = paid keys, limits taken from the *_MAX_RPS variables below
# replay = replays /fixtures/*.jsonl with mocked Helius/Birdeye. Needs no API keys.
PROVIDER_MODE=replay
# Replay speed multiplier (1–20) and which fixture file(s) to replay (glob, relative to FIXTURES_DIR)
REPLAY_SPEED=5
REPLAY_FILES=*.jsonl
# Where the recorder writes and replay reads JSONL streams. Recordings are kept this many days.
FIXTURES_DIR=./fixtures
FIXTURES_RETENTION_DAYS=14

# Redis (docker-compose provides `redis://redis:6379`)
REDIS_URL=redis://localhost:6379

# Worker health endpoint (GET /health) — bound to localhost only
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787

# Log level for pino: trace | debug | info | warn | error
LOG_LEVEL=info

# PumpPortal live data WebSocket (free, no key needed for the data API)
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# Helius RPC (https://dashboard.helius.dev)
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
# Max requests/second sent to Helius (free: 8, developer plan: up to 40)
HELIUS_MAX_RPS=8
# Monthly credit allowance of your Helius plan (for budget warnings)
HELIUS_MONTHLY_CREDITS=1000000

# Birdeye (https://bds.birdeye.so)
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
# Max requests/second sent to Birdeye (standard: 1, lite: up to 12)
BIRDEYE_MAX_RPS=1
# Max Gate-3 checks per day in `free` mode; after that Gate 3 is skipped
BIRDEYE_FREE_DAILY_GATE3_MAX=12
# Monthly compute-unit allowance of your Birdeye plan (for budget warnings)
BIRDEYE_MONTHLY_CU=30000

# Resend (worker sends alerts/digests; also configure it as Supabase Auth SMTP)
RESEND_API_KEY=
EMAIL_FROM=MemeRadar <alerts@your-domain.com>
# Where alerts are sent (the single user's address)
ALERT_EMAIL_TO=
